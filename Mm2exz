-- ==================== ระบบระบุบทบาทใน MM2 ====================
local function GetPlayerRole(player)
    if not player or not player.Character then return "Innocent", Color3.fromRGB(0, 255, 0) end
    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")
    
    local hasKnife = (char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife")))
    local hasGun = (char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun")))
    
    if hasKnife then
        return "Murderer", Color3.fromRGB(255, 0, 0)
    elseif hasGun then
        return "Sheriff", Color3.fromRGB(0, 150, 255)
    else
        return "Innocent", Color3.fromRGB(0, 255, 0)
    end
end

